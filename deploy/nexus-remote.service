[Unit]
Description=Nexus Remote Hub (WebSocket device control)
Documentation=file:///opt/nexus-remote/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nexus-remote
EnvironmentFile=/opt/nexus-remote/.env
ExecStart=/opt/nexus-remote/venv/bin/python /opt/nexus-remote/server.py \
  --host 127.0.0.1 \
  --ws-port 18765 \
  --http-port 18766 \
  --db /opt/nexus-remote/data/hub.db \
  --cookie-secure
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/nexus-remote/data
PrivateTmp=yes
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
