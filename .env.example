# 服务端管理员初始密码（部署时设置，勿提交真实值）
ADMIN_PASSWORD=change-me

# 统一验证码发信（Resend；免费版 3,000 封/月、100 封/天）
# 发信域：notify.example.com；需要先在 Resend 验证该域名并添加 DNS 记录。
RESEND_API_KEY=re_xxxxxxxxxxxx
TEAM_WORKERS_EMAIL_FROM=team-workers <no-reply@notify.example.com>
TEAM_WORKERS_EMAIL_REPLY_TO=support@example.com

# 控制端 token（每个用户独立，勿提交真实值）
CONTROL_TOKEN=change-me
